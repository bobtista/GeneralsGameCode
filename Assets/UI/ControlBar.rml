		<div id="cb-unit" class="panel" data-if="portrait_shown &amp;&amp; !sel_shown &amp;&amp; !cameo_movie">
			<div id="cb-portrait" data-if="portrait != ''" data-style-decorator="portrait != '' ? 'image(' + portrait + ')' : 'none'"><div class="vet" data-if="portrait_overlay != ''" data-style-decorator="portrait_overlay != '' ? 'image(' + portrait_overlay + ')' : 'none'"></div><span class="unit-hp" data-if="unit_hp_shown" data-class-mid="unit_hp_state == 1" data-class-low="unit_hp_state == 2">{{unit_hp}}</span></div>
			<div id="cb-plate">{{name}}<span class="many" data-if="select_count &gt; 1"> x{{select_count}}</span></div>
			<div id="cb-upgrades">
				<div class="upgrade" data-alias-u="upgrades[0]" data-if="u.shown" data-class-owned="u.owned"><div class="art" data-if="u.icon != ''" data-style-decorator="u.icon != '' ? 'image(' + u.icon + ')' : 'none'"></div></div>
				<div class="upgrade" data-alias-u="upgrades[1]" data-if="u.shown" data-class-owned="u.owned"><div class="art" data-if="u.icon != ''" data-style-decorator="u.icon != '' ? 'image(' + u.icon + ')' : 'none'"></div></div>
				<div class="upgrade" data-alias-u="upgrades[2]" data-if="u.shown" data-class-owned="u.owned"><div class="art" data-if="u.icon != ''" data-style-decorator="u.icon != '' ? 'image(' + u.icon + ')' : 'none'"></div></div>
				<div class="upgrade" data-alias-u="upgrades[3]" data-if="u.shown" data-class-owned="u.owned"><div class="art" data-if="u.icon != ''" data-style-decorator="u.icon != '' ? 'image(' + u.icon + ')' : 'none'"></div></div>
				<div class="upgrade" data-alias-u="upgrades[4]" data-if="u.shown" data-class-owned="u.owned"><div class="art" data-if="u.icon != ''" data-style-decorator="u.icon != '' ? 'image(' + u.icon + ')' : 'none'"></div></div>
			</div>
		</div>
		<div id="cb-movie" class="panel" data-if="cameo_movie"><video id="cb-movie-video" source="cameo-movie" fit="cover"></video></div>
		<div id="cb-observer" class="panel" data-if="observer_list_shown || observer_info_shown">
			<div data-if="observer_list_shown">
				<div class="obs-player" data-for="p : observer_players" data-if="p.shown" data-attr-data-cb="'o' + it_index"><span class="obs-name" data-style-color="p.color">{{p.name}}</span></div>
			</div>
			<div data-if="observer_info_shown">
				<div class="obs-title" data-style-color="observer_color">{{observer_name}}</div>
				<div class="obs-line"><gametext key="GUI:Units"/> {{observer_units}}</div>
				<div class="obs-line"><gametext key="GUI:Buildings"/> {{observer_buildings}}</div>
				<div class="obs-line"><gametext key="GUI:UnitsKilled"/> {{observer_kills}}</div>
				<div class="textbtn" data-cb="o8" data-alias-s="observer_buttons[8]" data-if="s.shown">BACK</div>
			</div>
		</div>
	</div>
	<div id="cb-tip" class="panel" data-if="tooltip_shown" data-class-left="tooltip_left">
		<div class="tip-top">
			<div class="tip-icon" data-if="tooltip_icon != ''" data-style-decorator="tooltip_icon != '' ? 'image(' + tooltip_icon + ')' : 'none'"></div>
			<div class="tip-lines"><div class="tip-name">{{tooltip_name}}</div><div class="tip-line" data-if="tooltip_key != ''">Hotkey: <span class="tip-keyv">{{tooltip_key}}</span></div><div class="tip-line" data-if="tooltip_time != ''">Build time: {{tooltip_time}}</div></div>
			<div class="tip-cost" data-if="tooltip_cost != ''">{{tooltip_cost}}</div>
		</div>
		<div class="tip-text">{{tooltip_description}}</div>
	</div>
	<div id="cb-factories" data-if="fac_shown &amp;&amp; !observer">
		<div class="fac" data-hud="f0" data-alias-f="facs[0]" data-if="f.shown"><div class="art" data-if="f.icon != ''" data-style-decorator="f.icon != '' ? 'image(' + f.icon + ')' : 'none'"></div><span class="cnt" data-if="f.count &gt; 1">{{f.count}}</span></div>
		<div class="fac" data-hud="f1" data-alias-f="facs[1]" data-if="f.shown"><div class="art" data-if="f.icon != ''" data-style-decorator="f.icon != '' ? 'image(' + f.icon + ')' : 'none'"></div><span class="cnt" data-if="f.count &gt; 1">{{f.count}}</span></div>
		<div class="fac" data-hud="f2" data-alias-f="facs[2]" data-if="f.shown"><div class="art" data-if="f.icon != ''" data-style-decorator="f.icon != '' ? 'image(' + f.icon + ')' : 'none'"></div><span class="cnt" data-if="f.count &gt; 1">{{f.count}}</span></div>
		<div class="fac" data-hud="f3" data-alias-f="facs[3]" data-if="f.shown"><div class="art" data-if="f.icon != ''" data-style-decorator="f.icon != '' ? 'image(' + f.icon + ')' : 'none'"></div><span class="cnt" data-if="f.count &gt; 1">{{f.count}}</span></div>
	</div>
	<div id="cb-science" class="panel" data-if="science_shown">
		<div class="sci-title">{{science_title}}</div>
		<div class="sci-label"><gametext key="GUI:Rank1Required"/></div><div class="sci-row">
			<div class="slot sci-slot" data-cb="g0" data-alias-s="sciences[0]" data-class-live="s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash"><div class="art" data-if="s.shown &amp;&amp; s.icon != ''" data-style-decorator="s.icon != '' ? 'image(' + s.icon + ')' : 'none'"></div><div class="vet" data-if="s.shown &amp;&amp; s.overlay != ''" data-style-decorator="s.overlay != '' ? 'image(' + s.overlay + ')' : 'none'"></div><div class="clock" data-if="s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><div class="shade"></div><span class="key" data-if="s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="count" data-if="s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
			<div class="slot sci-slot" data-cb="g1" data-alias-s="sciences[1]" data-class-live="s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash"><div class="art" data-if="s.shown &amp;&amp; s.icon != ''" data-style-decorator="s.icon != '' ? 'image(' + s.icon + ')' : 'none'"></div><div class="vet" data-if="s.shown &amp;&amp; s.overlay != ''" data-style-decorator="s.overlay != '' ? 'image(' + s.overlay + ')' : 'none'"></div><div class="clock" data-if="s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><div class="shade"></div><span class="key" data-if="s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="count" data-if="s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
			<div class="slot sci-slot" data-cb="g2" data-alias-s="sciences[2]" data-class-live="s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash"><div class="art" data-if="s.shown &amp;&amp; s.icon != ''" data-style-decorator="s.icon != '' ? 'image(' + s.icon + ')' : 'none'"></div><div class="vet" data-if="s.shown &amp;&amp; s.overlay != ''" data-style-decorator="s.overlay != '' ? 'image(' + s.overlay + ')' : 'none'"></div><div class="clock" data-if="s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><div class="shade"></div><span class="key" data-if="s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="count" data-if="s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
			<div class="slot sci-slot" data-cb="g3" data-alias-s="sciences[3]" data-class-live="s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash"><div class="art" data-if="s.shown &amp;&amp; s.icon != ''" data-style-decorator="s.icon != '' ? 'image(' + s.icon + ')' : 'none'"></div><div class="vet" data-if="s.shown &amp;&amp; s.overlay != ''" data-style-decorator="s.overlay != '' ? 'image(' + s.overlay + ')' : 'none'"></div><div class="clock" data-if="s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><div class="shade"></div><span class="key" data-if="s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="count" data-if="s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
