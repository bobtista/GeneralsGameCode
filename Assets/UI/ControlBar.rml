<rml>
<head>
	<title>Control bar</title>
	<!-- Ronin @feature 28/10/2026 DX9: the modern control bar in G2's placement (docs/UI_Work.md). Buttons carry data-cb
	     for RmlControlBarScreen: c command, q queue, s side, x context, i readout, p power, g promotion, o observer. -->
	<link type="text/rcss" href="common.rcss"/>
	<link type="text/rcss" href="ControlBar.rcss"/>
</head>
<body data-model="controlbar" data-class-low="low" data-class-observer="observer">
	<div id="cb-side" class="panel">
		<div class="sidebtn" data-cb="s0" data-alias-s="side_buttons[0]" data-if="s.shown" data-class-off="!s.enabled">MENU</div>
		<div class="sidebtn" data-cb="s3" data-alias-s="side_buttons[3]" data-if="s.shown" data-class-off="!s.enabled">DIPLOMACY</div>
		<div class="sidebtn" data-cb="s2" data-alias-s="side_buttons[2]" data-if="s.shown" data-class-off="!s.enabled">BEACON</div>
		<div class="sidebtn" data-cb="s1" data-alias-s="side_buttons[1]" data-if="s.shown" data-class-off="!s.enabled">IDLE<span class="badge" data-if="s.text != ''">{{s.text}}</span></div>
		<div class="sidebtn" data-cb="s5" data-alias-s="side_buttons[5]" data-if="s.shown" data-class-off="!s.enabled"><span data-if="!s.checked">HIDE HUD</span><span data-if="s.checked">SHOW HUD</span></div>
		<div class="replay" data-if="replay">REPLAY</div>
	</div>
	<div id="cb-map" class="panel">
		<div id="cb-economy">
			<div class="money" data-cb="i0" data-if="money_shown">{{money}}</div>
			<div class="power" data-cb="i1" data-if="power_shown" data-class-lowpower="power_state == 1" data-class-nopower="power_state == 2">
				<span class="power-text">{{power_text}}</span>
				<div class="power-bar"><div class="power-fill" data-style-width="power_fill"></div><div class="power-needle" data-style-left="power_needle"></div></div>
			</div>
		</div>
		<div id="cb-radar-frame" data-class-alert="radar_alert"><radar id="cb-radar" data-world-middle="1" data-class-dark="!has_radar"></radar></div>
	</div>
	<div id="cb-general" class="panel" data-if="!observer">
		<div id="cb-groups">
			<div class="grp" data-hud="g0" data-alias-g="groups[0]" data-class-empty="!g.shown" style="left: 0dp;"><div class="art" data-if="g.shown &amp;&amp; g.icon != ''" data-style-decorator="g.icon != '' ? 'image(' + g.icon + ')' : 'none'"></div><span class="key" data-if="g.shown">{{g.number}}</span><span class="count" data-if="g.shown">{{g.count}}</span><span class="gnum" data-if="!g.shown">{{g.number}}</span></div>
			<div class="grp" data-hud="g1" data-alias-g="groups[1]" data-class-empty="!g.shown" style="left: 45dp;"><div class="art" data-if="g.shown &amp;&amp; g.icon != ''" data-style-decorator="g.icon != '' ? 'image(' + g.icon + ')' : 'none'"></div><span class="key" data-if="g.shown">{{g.number}}</span><span class="count" data-if="g.shown">{{g.count}}</span><span class="gnum" data-if="!g.shown">{{g.number}}</span></div>
			<div class="grp" data-hud="g2" data-alias-g="groups[2]" data-class-empty="!g.shown" style="left: 90dp;"><div class="art" data-if="g.shown &amp;&amp; g.icon != ''" data-style-decorator="g.icon != '' ? 'image(' + g.icon + ')' : 'none'"></div><span class="key" data-if="g.shown">{{g.number}}</span><span class="count" data-if="g.shown">{{g.count}}</span><span class="gnum" data-if="!g.shown">{{g.number}}</span></div>
			<div class="grp" data-hud="g3" data-alias-g="groups[3]" data-class-empty="!g.shown" style="left: 135dp;"><div class="art" data-if="g.shown &amp;&amp; g.icon != ''" data-style-decorator="g.icon != '' ? 'image(' + g.icon + ')' : 'none'"></div><span class="key" data-if="g.shown">{{g.number}}</span><span class="count" data-if="g.shown">{{g.count}}</span><span class="gnum" data-if="!g.shown">{{g.number}}</span></div>
			<div class="grp" data-hud="g4" data-alias-g="groups[4]" data-class-empty="!g.shown" style="left: 180dp;"><div class="art" data-if="g.shown &amp;&amp; g.icon != ''" data-style-decorator="g.icon != '' ? 'image(' + g.icon + ')' : 'none'"></div><span class="key" data-if="g.shown">{{g.number}}</span><span class="count" data-if="g.shown">{{g.count}}</span><span class="gnum" data-if="!g.shown">{{g.number}}</span></div>
			<div class="grp" data-hud="g5" data-alias-g="groups[5]" data-class-empty="!g.shown" style="left: 225dp;"><div class="art" data-if="g.shown &amp;&amp; g.icon != ''" data-style-decorator="g.icon != '' ? 'image(' + g.icon + ')' : 'none'"></div><span class="key" data-if="g.shown">{{g.number}}</span><span class="count" data-if="g.shown">{{g.count}}</span><span class="gnum" data-if="!g.shown">{{g.number}}</span></div>
			<div class="grp" data-hud="g6" data-alias-g="groups[6]" data-class-empty="!g.shown" style="left: 270dp;"><div class="art" data-if="g.shown &amp;&amp; g.icon != ''" data-style-decorator="g.icon != '' ? 'image(' + g.icon + ')' : 'none'"></div><span class="key" data-if="g.shown">{{g.number}}</span><span class="count" data-if="g.shown">{{g.count}}</span><span class="gnum" data-if="!g.shown">{{g.number}}</span></div>
			<div class="grp" data-hud="g7" data-alias-g="groups[7]" data-class-empty="!g.shown" style="left: 315dp;"><div class="art" data-if="g.shown &amp;&amp; g.icon != ''" data-style-decorator="g.icon != '' ? 'image(' + g.icon + ')' : 'none'"></div><span class="key" data-if="g.shown">{{g.number}}</span><span class="count" data-if="g.shown">{{g.count}}</span><span class="gnum" data-if="!g.shown">{{g.number}}</span></div>
			<div class="grp" data-hud="g8" data-alias-g="groups[8]" data-class-empty="!g.shown" style="left: 360dp;"><div class="art" data-if="g.shown &amp;&amp; g.icon != ''" data-style-decorator="g.icon != '' ? 'image(' + g.icon + ')' : 'none'"></div><span class="key" data-if="g.shown">{{g.number}}</span><span class="count" data-if="g.shown">{{g.count}}</span><span class="gnum" data-if="!g.shown">{{g.number}}</span></div>
			<div class="grp" data-hud="g9" data-alias-g="groups[9]" data-class-empty="!g.shown" style="left: 405dp;"><div class="art" data-if="g.shown &amp;&amp; g.icon != ''" data-style-decorator="g.icon != '' ? 'image(' + g.icon + ')' : 'none'"></div><span class="key" data-if="g.shown">{{g.number}}</span><span class="count" data-if="g.shown">{{g.count}}</span><span class="gnum" data-if="!g.shown">{{g.number}}</span></div>
		</div>
		<div id="cb-powers" data-if="shortcuts_shown">
			<div class="slot power-slot" data-cb="p0" data-alias-s="shortcuts[0]" data-class-live="s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash"><div class="art" data-if="s.shown &amp;&amp; s.icon != ''" data-style-decorator="s.icon != '' ? 'image(' + s.icon + ')' : 'none'"></div><div class="vet" data-if="s.shown &amp;&amp; s.overlay != ''" data-style-decorator="s.overlay != '' ? 'image(' + s.overlay + ')' : 'none'"></div><div class="clock" data-if="s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><div class="shade"></div><span class="key" data-if="s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="count" data-if="s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
			<div class="slot power-slot" data-cb="p1" data-alias-s="shortcuts[1]" data-class-live="s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash"><div class="art" data-if="s.shown &amp;&amp; s.icon != ''" data-style-decorator="s.icon != '' ? 'image(' + s.icon + ')' : 'none'"></div><div class="vet" data-if="s.shown &amp;&amp; s.overlay != ''" data-style-decorator="s.overlay != '' ? 'image(' + s.overlay + ')' : 'none'"></div><div class="clock" data-if="s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><div class="shade"></div><span class="key" data-if="s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="count" data-if="s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
			<div class="slot power-slot" data-cb="p2" data-alias-s="shortcuts[2]" data-class-live="s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash"><div class="art" data-if="s.shown &amp;&amp; s.icon != ''" data-style-decorator="s.icon != '' ? 'image(' + s.icon + ')' : 'none'"></div><div class="vet" data-if="s.shown &amp;&amp; s.overlay != ''" data-style-decorator="s.overlay != '' ? 'image(' + s.overlay + ')' : 'none'"></div><div class="clock" data-if="s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><div class="shade"></div><span class="key" data-if="s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="count" data-if="s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
			<div class="slot power-slot" data-cb="p3" data-alias-s="shortcuts[3]" data-class-live="s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash"><div class="art" data-if="s.shown &amp;&amp; s.icon != ''" data-style-decorator="s.icon != '' ? 'image(' + s.icon + ')' : 'none'"></div><div class="vet" data-if="s.shown &amp;&amp; s.overlay != ''" data-style-decorator="s.overlay != '' ? 'image(' + s.overlay + ')' : 'none'"></div><div class="clock" data-if="s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><div class="shade"></div><span class="key" data-if="s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="count" data-if="s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
			<div class="slot power-slot" data-cb="p4" data-alias-s="shortcuts[4]" data-class-live="s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash"><div class="art" data-if="s.shown &amp;&amp; s.icon != ''" data-style-decorator="s.icon != '' ? 'image(' + s.icon + ')' : 'none'"></div><div class="vet" data-if="s.shown &amp;&amp; s.overlay != ''" data-style-decorator="s.overlay != '' ? 'image(' + s.overlay + ')' : 'none'"></div><div class="clock" data-if="s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><div class="shade"></div><span class="key" data-if="s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="count" data-if="s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
			<div class="slot power-slot" data-cb="p5" data-alias-s="shortcuts[5]" data-class-live="s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash"><div class="art" data-if="s.shown &amp;&amp; s.icon != ''" data-style-decorator="s.icon != '' ? 'image(' + s.icon + ')' : 'none'"></div><div class="vet" data-if="s.shown &amp;&amp; s.overlay != ''" data-style-decorator="s.overlay != '' ? 'image(' + s.overlay + ')' : 'none'"></div><div class="clock" data-if="s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><div class="shade"></div><span class="key" data-if="s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="count" data-if="s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
			<div class="slot power-slot" data-cb="p6" data-alias-s="shortcuts[6]" data-class-live="s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash"><div class="art" data-if="s.shown &amp;&amp; s.icon != ''" data-style-decorator="s.icon != '' ? 'image(' + s.icon + ')' : 'none'"></div><div class="vet" data-if="s.shown &amp;&amp; s.overlay != ''" data-style-decorator="s.overlay != '' ? 'image(' + s.overlay + ')' : 'none'"></div><div class="clock" data-if="s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><div class="shade"></div><span class="key" data-if="s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="count" data-if="s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
			<div class="slot power-slot" data-cb="p7" data-alias-s="shortcuts[7]" data-class-live="s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash"><div class="art" data-if="s.shown &amp;&amp; s.icon != ''" data-style-decorator="s.icon != '' ? 'image(' + s.icon + ')' : 'none'"></div><div class="vet" data-if="s.shown &amp;&amp; s.overlay != ''" data-style-decorator="s.overlay != '' ? 'image(' + s.overlay + ')' : 'none'"></div><div class="clock" data-if="s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><div class="shade"></div><span class="key" data-if="s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="count" data-if="s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
			<div class="slot power-slot" data-cb="p8" data-alias-s="shortcuts[8]" data-class-live="s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash"><div class="art" data-if="s.shown &amp;&amp; s.icon != ''" data-style-decorator="s.icon != '' ? 'image(' + s.icon + ')' : 'none'"></div><div class="vet" data-if="s.shown &amp;&amp; s.overlay != ''" data-style-decorator="s.overlay != '' ? 'image(' + s.overlay + ')' : 'none'"></div><div class="clock" data-if="s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><div class="shade"></div><span class="key" data-if="s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="count" data-if="s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
			<div class="slot power-slot" data-cb="p9" data-alias-s="shortcuts[9]" data-class-live="s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash"><div class="art" data-if="s.shown &amp;&amp; s.icon != ''" data-style-decorator="s.icon != '' ? 'image(' + s.icon + ')' : 'none'"></div><div class="vet" data-if="s.shown &amp;&amp; s.overlay != ''" data-style-decorator="s.overlay != '' ? 'image(' + s.overlay + ')' : 'none'"></div><div class="clock" data-if="s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><div class="shade"></div><span class="key" data-if="s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="count" data-if="s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
			<div class="slot power-slot" data-cb="p10" data-alias-s="shortcuts[10]" data-class-live="s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash"><div class="art" data-if="s.shown &amp;&amp; s.icon != ''" data-style-decorator="s.icon != '' ? 'image(' + s.icon + ')' : 'none'"></div><div class="vet" data-if="s.shown &amp;&amp; s.overlay != ''" data-style-decorator="s.overlay != '' ? 'image(' + s.overlay + ')' : 'none'"></div><div class="clock" data-if="s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><div class="shade"></div><span class="key" data-if="s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="count" data-if="s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
		</div>
		<div id="cb-rank">
			<div class="general" data-cb="s4" data-alias-s="side_buttons[4]" data-if="s.shown" data-class-off="!s.enabled" data-class-lit="general_lit"><span class="rank-num">{{rank}}</span><span class="badge" data-if="science_points &gt; 0">{{science_points}}</span></div>
			<div class="xp" data-cb="i2"><div class="xp-fill" data-style-width="experience"></div></div>
		</div>
	</div>
	<div id="cb-card" class="panel" data-if="commands_shown || context == 'construction' || context == 'ocl' || context == 'beacon'">
		<div id="cb-grid">
			<div class="slot" data-cb="c0" data-alias-s="commands[0]" style="left: 0dp; top: 0dp;" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash"><div class="art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''" data-style-decorator="s.icon != '' ? 'image(' + s.icon + ')' : 'none'"></div><div class="vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''" data-style-decorator="s.overlay != '' ? 'image(' + s.overlay + ')' : 'none'"></div><div class="clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><div class="shade"></div><span class="key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="count" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
			<div class="slot" data-cb="c1" data-alias-s="commands[1]" style="left: 0dp; top: 54dp;" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash"><div class="art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''" data-style-decorator="s.icon != '' ? 'image(' + s.icon + ')' : 'none'"></div><div class="vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''" data-style-decorator="s.overlay != '' ? 'image(' + s.overlay + ')' : 'none'"></div><div class="clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><div class="shade"></div><span class="key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="count" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
			<div class="slot" data-cb="c2" data-alias-s="commands[2]" style="left: 66dp; top: 0dp;" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash"><div class="art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''" data-style-decorator="s.icon != '' ? 'image(' + s.icon + ')' : 'none'"></div><div class="vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''" data-style-decorator="s.overlay != '' ? 'image(' + s.overlay + ')' : 'none'"></div><div class="clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><div class="shade"></div><span class="key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="count" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
