<rml>
<head>
	<title>Main Menu</title>
	<link type="text/rcss" href="common.rcss"/>
	<link type="text/rcss" href="ShellCommon.rcss"/>
	<link type="text/rcss" href="MainMenu.rcss"/>
</head>
<!-- Layout variant: mm-d (HQ command terminal, default), mm-a (floating menu), mm-b (command rail) or
     mm-c (bottom bar). See MainMenu.rcss. -->
<body class="screen mm-d" data-model="mainmenu" data-class-backdrop="no_shellmap">
	<!-- Soft fade behind the menu, darkest at the screen's left edge; under the ruler. -->
	<div class="d-shade"></div>

	<div class="screen-ruler"><div class="rs rs-top"><div></div><div></div><div></div><div></div></div><div class="rs rs-bottom"><div></div><div></div><div></div><div></div></div><div class="rs rs-left"><div></div><div></div></div><div class="rs rs-right"><div></div><div></div></div><div class="rc rc-tl"><div></div></div><div class="rc rc-tr"><div></div></div><div class="rc rc-bl"><div></div></div><div class="rc rc-br"><div></div></div></div>

	<!-- Header strip: logo left; online status and the local time right. -->
	<div class="hq-band hq-header"><div class="hq-band-in">
		<mappedimage name="GeneralsLogo" class="hq-logo"/>
		<div class="hq-status">
			<div class="hq-pill" data-if="logged_in"><span class="hq-dot"></span><span class="hq-count" data-if="online_count_text != ''">{{online_count_text}}</span><span class="hq-sep" data-if="online_count_text != '' &amp;&amp; player_name != ''"></span><span class="hq-name" data-if="player_name != ''">{{player_name}}</span></div>
			<div class="hq-pill hq-off" data-if="!logged_in"><span class="hq-dot"></span>Offline</div>
			<div class="hq-clock" data-if="clock_text != ''">{{clock_text}}</div>
		</div>
	</div></div>

	<div class="screen-frame mm-frame">
		<!-- Faction emblem over the shell map: the solo panel's hover preview (MainMenu.cpp's
		     GBM_MOUSE_ENTERING/LEAVING art) and the difficulty panel's chosen side. -->
		<div class="mm-hero" data-class-diff="panel == 'difficulty'">
			<mappedimage name="SAFactionLogo144_US" data-class-visible="(panel == 'single' &amp;&amp; hover_faction == 'USA') || (panel == 'difficulty' &amp;&amp; selected_faction == 'USA')"/>
			<mappedimage name="SUFactionLogo144_GLA" data-class-visible="(panel == 'single' &amp;&amp; hover_faction == 'GLA') || (panel == 'difficulty' &amp;&amp; selected_faction == 'GLA')"/>
			<mappedimage name="SNFactionLogo144_China" data-class-visible="(panel == 'single' &amp;&amp; hover_faction == 'China') || (panel == 'difficulty' &amp;&amp; selected_faction == 'China')"/>
			<mappedimage name="Training144" data-class-visible="panel == 'single' &amp;&amp; hover_faction == 'Training'"/>
		</div>

		<!-- Logo and the root menu; the root stays up while a sub-panel is open beside it. -->
		<div class="mm-left">
			<mappedimage name="GeneralsLogo" class="mm-logo"/>

			<div class="mm-menu">
				<button class="mm-item" data-class-current="panel == 'single' || panel == 'difficulty'" data-event-click="go_single"><gametext key="GUI:SinglePlayer"/><span class="mm-more">&#8250;</span></button>
				<button class="mm-item" data-class-current="panel == 'multi'" data-event-click="go_multi"><gametext key="GUI:Multiplayer"/><span class="mm-more">&#8250;</span></button>
				<button class="mm-item" data-class-current="panel == 'loadreplay'" data-event-click="go_loadreplay"><gametext key="GUI:ReplayMenu"/><span class="mm-more">&#8250;</span></button>
				<button class="mm-item" data-hook="options" data-event-click="go_options"><gametext key="GUI:Options"/></button>
				<button class="mm-item" data-event-click="go_credits"><gametext key="GUI:Credits"/></button>
				<div class="mm-rule"></div>
				<button class="mm-item mm-quiet" data-hook="exit" data-event-click="go_exit"><gametext key="GUI:Exit"/></button>
			</div>
		</div>

		<!-- Sub-panels open beside (or above) the menu; only the active one is laid out. -->
		<div class="mm-sub" data-class-open="panel != 'main'">
			<!-- Single player: skirmish, campaign faction pick, Generals Challenge -->
			<div class="panel" data-class-active="panel == 'single'">
				<div class="mm-heading"><gametext key="GUI:SinglePlayer"/></div>
				<button class="mm-item" data-hook="skirmish" data-event-click="go_skirmish" data-tooltip="GUI:SkirmishLower"><gametext key="GUI:Skirmish"/></button>
				<button class="mm-item" data-hook="usa" data-event-click="select_usa" data-event-mouseover="preview_usa" data-event-mouseout="preview_clear" data-tooltip="TOOLTIP:Campaign3"><gametext key="GUI:USA"/><span class="mm-more">&#8250;</span></button>
				<button class="mm-item" data-hook="gla" data-event-click="select_gla" data-event-mouseover="preview_gla" data-event-mouseout="preview_clear" data-tooltip="TOOLTIP:Campaign2"><gametext key="GUI:GLA"/><span class="mm-more">&#8250;</span></button>
				<button class="mm-item" data-hook="china" data-event-click="select_china" data-event-mouseover="preview_china" data-event-mouseout="preview_clear" data-tooltip="TOOLTIP:Campaign1"><gametext key="GUI:CHINA_Caps"/><span class="mm-more">&#8250;</span></button>
				<button class="mm-item" data-hook="challenge" data-event-click="select_challenge" data-event-mouseover="preview_challenge" data-event-mouseout="preview_clear" data-tooltip="TOOLTIP:ChallengeButton"><gametext key="GUI:Generals_Challenge"/><span class="mm-more">&#8250;</span></button>
				<div class="mm-rule"></div>
				<button class="mm-item mm-back" data-event-click="back_main"><span class="chevron">&#8249;</span><gametext key="GUI:Back"/></button>
			</div>

			<!-- Multiplayer -->
			<div class="panel" data-class-active="panel == 'multi'">
				<div class="mm-heading"><gametext key="GUI:Multiplayer"/></div>
				<button class="mm-item" data-hook="online" data-event-click="go_online"><gametext key="GUI:GeneralsOnline"/></button>
				<button class="mm-item" data-hook="network" data-event-click="go_network"><gametext key="GUI:Network"/></button>
				<div class="mm-rule"></div>
				<button class="mm-item mm-back" data-event-click="back_main"><span class="chevron">&#8249;</span><gametext key="GUI:Back"/></button>
			</div>

			<!-- Load/Replay -->
			<div class="panel" data-class-active="panel == 'loadreplay'">
				<div class="mm-heading"><gametext key="GUI:ReplayMenu"/></div>
				<button class="mm-item" data-event-click="go_load_game"><gametext key="GUI:MainMenuLoadGame"/></button>
				<button class="mm-item" data-event-click="go_replay"><gametext key="GUI:MainMenuLoadReplay"/></button>
				<div class="mm-rule"></div>
				<button class="mm-item mm-back" data-event-click="back_main"><span class="chevron">&#8249;</span><gametext key="GUI:Back"/></button>
			</div>

			<!-- Campaign difficulty select (reached from single player's faction/challenge buttons) -->
			<div class="panel" data-class-active="panel == 'difficulty'">
				<div class="mm-heading"><gametext key="GUI:SelectDifficulty"/></div>
				<button class="mm-item" data-event-click="select_easy"><gametext key="GUI:EasyCaps"/></button>
				<button class="mm-item" data-event-click="select_medium"><gametext key="GUI:MediumDifficultyCaps"/></button>
				<button class="mm-item" data-event-click="select_hard"><gametext key="GUI:HardCaps"/></button>
				<div class="mm-rule"></div>
				<button class="mm-item mm-back" data-event-click="diff_back"><span class="chevron">&#8249;</span><gametext key="GUI:Back"/></button>
			</div>
		</div>

		<!-- Generals Online: who is online and the message of the day. The client has them only while
		     logged in, so the card is only there then. -->
		<div class="mm-news" data-if="has_news || players_online_text != ''" data-class-covered="panel != 'main'">
			<div class="mm-news-head">
				<div class="mm-news-title">Generals Online</div>
				<div class="mm-online" data-if="players_online_text != ''"><span class="dot"></span>{{players_online_text}}</div>
			</div>
			<div class="mm-motd" data-if="has_news">
				<div class="mm-motd-line" data-for="line : news_lines">{{line}}</div>
			</div>
		</div>

		<!-- Build: one small line. -->
		<div class="mm-build">{{ version }}</div>

		<!-- ==== D: HQ command terminal (only laid out in mm-d) ==== -->
		<!-- Root menu, lower left: big stencil labels over a line of description; brackets, an index and a
		     scan line on hover. -->
		<div class="d-menu">
			<button class="d-item hq-brackets" data-class-current="panel == 'single' || panel == 'difficulty'" data-event-click="go_single"><div class="d-text"><div class="d-label"><gametext key="GUI:SinglePlayer"/></div><div class="d-desc">Campaign, skirmish and Generals' Challenge</div></div><span class="hq-scan"></span><span class="hq-br hq-br-tl"></span><span class="hq-br hq-br-tr"></span><span class="hq-br hq-br-bl"></span><span class="hq-br hq-br-br"></span></button>
			<button class="d-item hq-brackets" data-class-current="panel == 'multi'" data-event-click="go_multi"><div class="d-text"><div class="d-label"><gametext key="GUI:Multiplayer"/></div><div class="d-desc">Online and LAN battles</div></div><span class="hq-scan"></span><span class="hq-br hq-br-tl"></span><span class="hq-br hq-br-tr"></span><span class="hq-br hq-br-bl"></span><span class="hq-br hq-br-br"></span></button>
			<button class="d-item hq-brackets" data-class-current="panel == 'loadreplay'" data-event-click="go_loadreplay"><div class="d-text"><div class="d-label"><gametext key="GUI:ReplayMenu"/></div><div class="d-desc">Saved games and replays</div></div><span class="hq-scan"></span><span class="hq-br hq-br-tl"></span><span class="hq-br hq-br-tr"></span><span class="hq-br hq-br-bl"></span><span class="hq-br hq-br-br"></span></button>
			<button class="d-item hq-brackets" data-hook="options" data-event-click="go_options"><div class="d-text"><div class="d-label"><gametext key="GUI:Options"/></div><div class="d-desc">Video, audio and controls</div></div><span class="hq-scan"></span><span class="hq-br hq-br-tl"></span><span class="hq-br hq-br-tr"></span><span class="hq-br hq-br-bl"></span><span class="hq-br hq-br-br"></span></button>
			<button class="d-item hq-brackets" data-event-click="go_credits"><div class="d-text"><div class="d-label"><gametext key="GUI:Credits"/></div><div class="d-desc">The people behind the game</div></div><span class="hq-scan"></span><span class="hq-br hq-br-tl"></span><span class="hq-br hq-br-tr"></span><span class="hq-br hq-br-bl"></span><span class="hq-br hq-br-br"></span></button>
			<button class="d-exit" data-hook="exit" data-event-click="go_exit"><span class="d-exit-mark"></span><gametext key="GUI:Exit"/></button>
		</div>

		<!-- Sub-panels: a row of cards beside the menu; only the active row is laid out. -->
		<div class="d-cards" data-class-open="panel != 'main'">
			<div class="d-row" data-class-active="panel == 'single'">
				<div class="d-row-head"><div class="d-row-title"><gametext key="GUI:SinglePlayer"/></div></div>
				<div class="d-deck">
				<div class="d-group">
				<div class="d-group-head"><gametext key="GUI:Campaign"/></div>
				<div class="d-group-cards">
				<button class="hq-card d-card d-fac" data-hook="usa" data-event-click="select_usa" data-event-mouseover="preview_usa" data-event-mouseout="preview_clear" data-tooltip="TOOLTIP:Campaign3"><div class="hq-art d-art"><mappedimage class="d-full" name="MissionLoad_USA"/><div class="d-shine"></div></div><div class="hq-card-text d-card-text"><div class="hq-card-title"><gametext key="GUI:USA"/></div></div><span class="hq-edge"></span></button>
				<button class="hq-card d-card d-fac" data-hook="gla" data-event-click="select_gla" data-event-mouseover="preview_gla" data-event-mouseout="preview_clear" data-tooltip="TOOLTIP:Campaign2"><div class="hq-art d-art"><mappedimage class="d-full" name="MissionLoad_GLA"/><div class="d-shine"></div></div><div class="hq-card-text d-card-text"><div class="hq-card-title"><gametext key="GUI:GLA"/></div></div><span class="hq-edge"></span></button>
				<button class="hq-card d-card d-fac" data-hook="china" data-event-click="select_china" data-event-mouseover="preview_china" data-event-mouseout="preview_clear" data-tooltip="TOOLTIP:Campaign1"><div class="hq-art d-art"><mappedimage class="d-full" name="MissionLoad_China"/><div class="d-shine"></div></div><div class="hq-card-text d-card-text"><div class="hq-card-title"><gametext key="GUI:CHINA_Caps"/></div></div><span class="hq-edge"></span></button>
				</div>
				</div>
				<button class="hq-card d-card d-solo" data-hook="skirmish" data-event-click="go_skirmish" data-tooltip="GUI:SkirmishLower"><div class="hq-art d-art"><mappedimage class="d-bg" name="MDSkirmishLoadB"/><div class="d-tint"></div><mappedimage class="d-emb" name="Skirmish144"/></div><div class="hq-card-text d-card-text"><div class="hq-card-title"><gametext key="GUI:Skirmish"/></div><div class="hq-card-desc">Battle the AI on any map</div></div><span class="hq-edge"></span></button>
				<button class="hq-card d-card d-solo" data-hook="challenge" data-event-click="select_challenge" data-event-mouseover="preview_challenge" data-event-mouseout="preview_clear" data-tooltip="TOOLTIP:ChallengeButton"><div class="hq-art d-art"><mappedimage class="d-bg" name="GCBackgroundMinSpec"/><div class="d-tint"></div><mappedimage class="d-emb" name="Training144"/></div><div class="hq-card-text d-card-text"><div class="hq-card-title"><gametext key="GUI:Generals_Challenge"/></div><div class="hq-card-desc">Defeat the generals one by one</div></div><span class="hq-edge"></span></button>
				</div>
			</div>

			<div class="d-row" data-class-active="panel == 'multi'">
				<div class="d-row-head"><div class="d-row-title"><gametext key="GUI:Multiplayer"/></div></div>
				<div class="d-deck">
				<button class="hq-card d-card d-wide" data-hook="online" data-event-click="go_online" data-tooltip="TOOLTIP:Online"><div class="hq-art d-art"><mappedimage class="d-bg" name="GCBackgroundMinSpec"/><div class="d-tint"></div><mappedimage class="d-medal" name="GlobalGen"/></div><div class="hq-card-text d-card-text"><div class="hq-card-title"><gametext key="GUI:GeneralsOnline"/></div><div class="hq-card-desc">Ranked and custom games on Generals Online</div></div><span class="hq-edge"></span></button>
				<button class="hq-card d-card d-wide" data-hook="network" data-event-click="go_network" data-tooltip="TOOLTIP:Network"><div class="hq-art d-art"><mappedimage class="d-bg" name="EarthMap"/><div class="d-tint"></div><div class="d-glyph g-net"><span class="l l1"></span><span class="l l2"></span><span class="l l3"></span><span class="n n0"></span><span class="n n1"></span><span class="n n2"></span><span class="n n3"></span></div></div><div class="hq-card-text d-card-text"><div class="hq-card-title"><gametext key="GUI:Network"/></div><div class="hq-card-desc">Play over your local network</div></div><span class="hq-edge"></span></button>
				</div>
			</div>

			<div class="d-row d-list" data-class-active="panel == 'loadreplay'">
				<div class="d-row-head"><div class="d-row-title"><gametext key="GUI:ReplayMenu"/></div></div>
				<div class="d-deck">
				<button class="hq-card d-card d-line" data-event-click="go_load_game"><div class="hq-card-text d-card-text"><div class="hq-card-title"><gametext key="GUI:MainMenuLoadGame"/></div><div class="hq-card-desc">Resume a saved mission</div></div><span class="hq-edge"></span></button>
				<button class="hq-card d-card d-line" data-event-click="go_replay"><div class="hq-card-text d-card-text"><div class="hq-card-title"><gametext key="GUI:MainMenuLoadReplay"/></div><div class="hq-card-desc">Watch your recorded battles</div></div><span class="hq-edge"></span></button>
				</div>
			</div>

			<!-- Campaign difficulty: the chosen side, then three levels. -->
			<div class="d-row" data-class-active="panel == 'difficulty'">
				<div class="d-row-head"><div class="d-row-title"><gametext key="GUI:SelectDifficulty"/></div></div>
				<div class="d-deck">
				<div class="hq-card d-card d-pick">
					<div class="hq-art d-art">
						<mappedimage class="d-full" name="MissionLoad_USA" data-if="selected_faction == 'USA'"/>
						<mappedimage class="d-full" name="MissionLoad_GLA" data-if="selected_faction == 'GLA'"/>
						<mappedimage class="d-full" name="MissionLoad_China" data-if="selected_faction == 'China'"/>
						<mappedimage class="d-bg" name="GCBackgroundMinSpec" data-if="selected_faction == 'Training'"/>
						<div class="d-tint" data-if="selected_faction == 'Training'"></div>
						<mappedimage class="d-emb" name="Training144" data-if="selected_faction == 'Training'"/>
						<div class="d-shine"></div>
					</div>
					<div class="hq-card-text d-card-text">
						<div class="hq-card-title" data-if="selected_faction == 'USA'"><gametext key="GUI:USA"/></div>
						<div class="hq-card-title" data-if="selected_faction == 'GLA'"><gametext key="GUI:GLA"/></div>
						<div class="hq-card-title" data-if="selected_faction == 'China'"><gametext key="GUI:CHINA_Caps"/></div>
						<div class="hq-card-title" data-if="selected_faction == 'Training'"><gametext key="GUI:Generals_Challenge"/></div>
						<div class="hq-card-desc" data-if="selected_faction != 'Training'"><gametext key="GUI:Campaign"/></div>
					</div>
				</div>
				<button class="hq-card d-card d-diff" data-event-click="select_easy"><div class="hq-art d-art"><div class="d-level"><span class="bar on"></span><span class="bar"></span><span class="bar"></span></div></div><div class="hq-card-text d-card-text"><div class="hq-card-title"><gametext key="GUI:EasyCaps"/></div><div class="hq-card-desc">For new commanders</div></div><span class="hq-edge"></span></button>
				<button class="hq-card d-card d-diff" data-event-click="select_medium"><div class="hq-art d-art"><div class="d-level"><span class="bar on"></span><span class="bar on"></span><span class="bar"></span></div></div><div class="hq-card-text d-card-text"><div class="hq-card-title"><gametext key="GUI:MediumDifficultyCaps"/></div><div class="hq-card-desc">A fair fight</div></div><span class="hq-edge"></span></button>
				<button class="hq-card d-card d-diff" data-event-click="select_hard"><div class="hq-art d-art"><div class="d-level"><span class="bar on"></span><span class="bar on"></span><span class="bar on"></span></div></div><div class="hq-card-text d-card-text"><div class="hq-card-title"><gametext key="GUI:HardCaps"/></div><div class="hq-card-desc">No mercy for veterans</div></div><span class="hq-edge"></span></button>
				</div>
			</div>
		</div>
	</div>

	<!-- Bottom ticker: Generals Online news scrolling while logged in, else the build. The slide
	     brings the run in from the right edge (its left, a share of the viewport) while the run moves
	     back by its own width (its left, a share of the shrink-to-fit track), so the text enters on
	     the right and leaves on the left whatever its length. -->
	<div class="hq-band hq-ticker"><div class="hq-band-in">
		<div class="hq-tag" data-if="has_news"><span class="hq-dot"></span>Generals Online</div>
		<div class="hq-tk-view" data-if="has_news">
			<div class="hq-tk-slide"><div class="hq-tk-track"><div class="hq-tk-run"><span data-for="line : news_lines"><span class="hq-tk-item" data-if="line != ' ' &amp;&amp; line != ''">{{line}}</span></span></div></div></div>
			<div class="hq-tk-fade"></div>
		</div>
		<div class="hq-tk-static" data-if="!has_news">{{ version }}</div>
	</div></div>
</body>
</rml>
